# Copia para .env e ajusta. Valores de demonstração — NÃO usar em produção.

# JWT partilhado: o Users Service emite os tokens; os outros serviços só os validam.
JWT_SECRET=demo-jwt-secret-change-me-at-least-32-bytes
JWT_EXPIRE_MINUTES=1440

# Token para chamadas entre serviços (/internal/*)
INTERNAL_SERVICE_TOKEN=demo-internal-token-change-me

# Bases de dados (uma por serviço)
USERS_DB_PASSWORD=users_demo_pw
RECIPE_DB_PASSWORD=recipe_demo_pw
INTERACTION_DB_PASSWORD=interaction_demo_pw
ACTIVITY_DB_PASSWORD=activity_demo_pw

# Portas expostas no computador
USERS_PORT=8001
RECIPE_PORT=8002
INTERACTION_PORT=8003
ACTIVITY_PORT=8004

# CORS (desenvolvimento)
CORS_ORIGINS=*
